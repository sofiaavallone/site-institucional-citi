# ========== WEB (apps/web/.env.local) ==========
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública do site (usada em metadados/SEO e Open Graph). Em produção,
# defina a URL real, ex.: https://citi.org.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========== SERVER (apps/server/.env) ==========
# DATABASE_URL: usada pelo server em runtime
# Host = "postgres"
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/projectdb?schema=public"

# DATABASE_DIRECT_URL: usada pelo Prisma CLI local (migrations, studio)
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/projectdb?schema=public"

PORT=3001
WEB_URL=http://localhost:3000

# Envio do formulário de contato (Resend — https://resend.com)
RESEND_API_KEY=
# Remetente verificado no Resend (em testes pode usar onboarding@resend.dev)
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Caixa que recebe os leads do formulário
CONTACT_TO_EMAIL=citi@cin.ufpe.br

# ========== MOBILE (apps/mobile/.env) ==========
EXPO_PUBLIC_API_URL=http://localhost:3001
