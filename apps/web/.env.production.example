# ============================================================
# WEB (apps/web) — variáveis de PRODUÇÃO
# Defina estas na Vercel ANTES do build (NEXT_PUBLIC_* é congelado no build).
# Troque os valores de exemplo pelos reais.
# ============================================================

# URL pública da API (apps/server). Precisa ser HTTPS, senão o navegador
# bloqueia a chamada do formulário (mixed content).
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# URL pública do site (usada em SEO/Open Graph). Domínio final, com https.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com
