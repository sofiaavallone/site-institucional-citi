# ============================================================
# SERVER (apps/server) — variáveis de PRODUÇÃO
# Defina estas no provedor da API (Render / Railway / Fly).
# Troque os valores de exemplo pelos reais.
# ============================================================

# Porta (muitos provedores injetam PORT automaticamente; pode deixar comentado).
# PORT=3001

# Origem EXATA do site, para o CORS. Tem que bater 100%: protocolo, domínio
# e com/sem "www". Se não bater, o navegador bloqueia o envio do formulário.
WEB_URL=https://www.seudominio.com

# ---------- Envio do formulário de contato (Resend) ----------
# Chave da API do Resend (https://resend.com/api-keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente: PRECISA ser de um domínio verificado no Resend.
# onboarding@resend.dev só funciona em teste (entrega só pra sua própria conta).
CONTACT_FROM_EMAIL=site@seudominio.com

# Caixa que recebe os leads do formulário.
CONTACT_TO_EMAIL=citi@cin.ufpe.br

# ---------- Banco (só se for usar /users ou persistência) ----------
# O formulário de contato NÃO precisa de banco. Preencha apenas se for usar
# os endpoints de usuários / Prisma.
# DATABASE_URL="postgresql://usuario:senha@host:5432/db?schema=public"
# DATABASE_DIRECT_URL="postgresql://usuario:senha@host:5432/db?schema=public"
